# Multi-Agent Orchestrator (MAO) - Environment Variables
# Get your Orshot API key from https://orshot.com

# MCP Backend (Orshot) — Required for real image generation
ORSHOT_API_KEY=

# MCP Server URL (default: https://mcp.orshot.com/mcp)
MCP_URL=

# OpenCode API Key (alternative to ORSHOT_API_KEY)
OPENCODE_API_KEY=

# Vectorizer.AI (for vectorization)
VECTORIZER_API_ID=
VECTORIZER_API_SECRET=

# OpenAI (for Tier 2 AI quality checks, optional)
OPENAI_API_KEY=
